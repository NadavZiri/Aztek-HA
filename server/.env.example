DATABASE_URL=postgresql://weather:replace-with-a-local-database-password@localhost:5432/weather
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OPENWEATHER_API_KEY=replace-with-your-openweather-key
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
BIND_HOST=127.0.0.1
DEPLOYMENT_ROLE=active
TRUST_PROXY_HOPS=0
# Azure deployment injects FRONT_DOOR_ID and FRONT_DOOR_SECRET through Key Vault.
# Do not set them for ordinary local development.
# Backend configuration: copy this file to server/.env.
